# Port the HTTP server listens on
PORT=3000

# Max requests per IP per 60-second window
RATE_LIMIT_PER_MINUTE=20

# Number of reverse-proxy hops to trust for X-Forwarded-For (Express "trust proxy" setting).
# Coolify/Traefik sits in front of this service, so this should stay 1 in production.
TRUST_PROXY=1
